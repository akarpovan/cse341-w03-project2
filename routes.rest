### ============================
### Environment variables
### ============================
@dev = http://localhost:3000
@contentType = application/json


### ============================
### ARTISTS
### ============================

### Get all artists
GET {{dev}}/artists

### Get a single artist by id (reemplaza con un _id real de tu colección artists)
GET {{dev}}/artists/6aab6d43cf86b74f6b374cb7

### Test with an invalid id format
GET {{dev}}/artists/123

### Test with a valid format id that does not exist
GET {{dev}}/artists/000000000000000000000000

### Create artist
# @name createArtist
POST {{dev}}/artists HTTP/1.1
content-type: {{contentType}}

{
    "fname": "Salvador",
    "mname": "",
    "lname": "Dali",
    "dob": "1904",
    "dod": "1989",
    "country": "Spain",
    "localArtist": false
}

### Verify the new artist was created (usa el id devuelto por el POST de arriba)
GET {{dev}}/artists/{{createArtist.response.body.id}}

### Create artist with missing/invalid fields (should return 412 validation error)
POST {{dev}}/artists HTTP/1.1
content-type: {{contentType}}

{
    "fname": "",
    "lname": "Test"
}

### Update the artist created above (valid data)
PUT {{dev}}/artists/{{createArtist.response.body.id}} HTTP/1.1
content-type: {{contentType}}

{
    "fname": "Salvador",
    "mname": "Domingo",
    "lname": "Dali",
    "dob": "1904",
    "dod": "1989",
    "country": "Spain",
    "localArtist": true
}

### Verify the update
GET {{dev}}/artists/{{createArtist.response.body.id}}

### Try to update with an invalid id format (should return 400)
PUT {{dev}}/artists/123 HTTP/1.1
content-type: {{contentType}}

{
    "fname": "Salvador",
    "mname": "Domingo",
    "lname": "Dali",
    "dob": "1904",
    "dod": "1989",
    "country": "Spain",
    "localArtist": true
}

### Try to update with invalid body data (should return 412 validation error)
PUT {{dev}}/artists/{{createArtist.response.body.id}} HTTP/1.1
content-type: {{contentType}}

{
    "fname": "",
    "lname": "Dali"
}

### Delete the artist created above
DELETE {{dev}}/artists/{{createArtist.response.body.id}}

### Verify the delete (should return 404 / not found)
GET {{dev}}/artists/{{createArtist.response.body.id}}

### Try to delete with an invalid id format (should return 400)
DELETE {{dev}}/artists/123


